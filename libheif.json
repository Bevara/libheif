{
    "name": "libheif",
    "version": "1.0.1",
    "description": "HEIF/HEIC image decoder",
    "filters":["heifdec","rfheif"],
    "help": "This filter decodes HEIF/HEIC (HEVC-coded) images using libheif. For AVIF (AV1-coded), use the lighter avif;libaom filter pair instead.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libheif.accessor",
    "filter_source":{
        "heifdec" : "dec_heif.c",
        "rfheif" : "reframe_heif.c"
    },
    "extension":{
      "heic" : "img",
      "heics" : "img",
      "heif" : "img",
      "heifs" : "img"
    },
    "using": ["mm_solver_1.0.1"],
    "runtime": {
        "heifdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "licence-required",
        "note": "HEIC is HEVC: Access Advance, Via LA",
        "checked": "2026-10-16"
    }
}
